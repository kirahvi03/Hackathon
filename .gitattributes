# Normalize line endings in the repository; keep files usable on Windows.
* text=auto

*.sh   text eol=lf
*.bash text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.xlsx binary
*.docx binary
*.pptx binary
